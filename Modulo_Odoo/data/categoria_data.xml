<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Seed Category 1: Pan -->
        <record id="categoria_pan" model="panaderia.categoria">
            <field name="name">Pan</field>
            <field name="codigo">PAN</field>
            <field name="sequence">10</field>
            <field name="descripcion">Variedad de panes tradicionales, dulces, rústicos y artesanales (e.g. Francés, Baguette, Dulce).</field>
            <field name="active">True</field>
        </record>

        <!-- Seed Category 2: Pastel -->
        <record id="categoria_pastel" model="panaderia.categoria">
            <field name="name">Pastel</field>
            <field name="codigo">PAS</field>
            <field name="sequence">20</field>
            <field name="descripcion">Pasteles para eventos, porciones individuales, postres fríos y tartas (e.g. Selva Negra, Tres Leches, Tartas).</field>
            <field name="active">True</field>
        </record>

        <!-- Seed Category 3: Galleta -->
        <record id="categoria_galleta" model="panaderia.categoria">
            <field name="name">Galleta</field>
            <field name="codigo">GAL</field>
            <field name="sequence">30</field>
            <field name="descripcion">Galletas horneadas, polvorones, pastas secas y repostería menor (e.g. Chispas, Avena, Mantequilla).</field>
            <field name="active">True</field>
        </record>

        <!-- Seed Category 4: Bebida -->
        <record id="categoria_bebida" model="panaderia.categoria">
            <field name="name">Bebida</field>
            <field name="codigo">BEB</field>
            <field name="sequence">40</field>
            <field name="descripcion">Cafetería caliente, bebidas frías, jugos naturales y lácteos (e.g. Café, Jugos, Refrescos).</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
